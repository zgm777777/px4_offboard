<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypenamespace="xsd" schemalocation="http://download.ros.org/schema/package_format3.xsd"?>
<package format="3">
  <name>px4_gui</name>
  <version>0.1.0</version>
  <description>Qt GUI for PX4 offboard mode switching and velocity control</description>
  <maintainer email="user@example.com">user</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>px4_msgs</depend>
  <depend>offboard_manager</depend>

  <build_depend>qtbase5-dev</build_depend>
  <build_depend>qtcharts5-dev</build_depend>
  <exec_depend>libqt5-core</exec_depend>
  <exec_depend>libqt5-gui</exec_depend>
  <exec_depend>libqt5-widgets</exec_depend>
  <exec_depend>libqt5-charts</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
