<?xml version="1.0"?>
<package format="3">
  <name>joy_mode_switcher</name>
  <version>0.1.0</version>
  <description>Bridge joystick button events on /joy to offboard_manager services.</description>
  <maintainer email="dev@example.com">joy_mode_switcher</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>offboard_manager</depend>

  <exec_depend>joy</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
